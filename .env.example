# Copy to .env.local and fill in.

# The waitlist register API the card posts to.
#
# NEXT_PUBLIC_* is read at build time and inlined into the client bundle, so
# this value ships to the browser in plain sight. It is a location, not a
# secret — never put a key or token here. Without it the build fails loudly
# rather than shipping a site whose form silently does nothing.
NEXT_PUBLIC_REGISTER_URL=

# The preferred production origin, used for canonical URLs, Open Graph URLs and
# the sitemap. Apex, no www — and it must match the host's primary domain, or
# the canonical tag and the redirect target will disagree.
# Unset, no canonical tags are emitted and sitemap.xml is empty, on purpose.
NEXT_PUBLIC_SITE_URL=

# Server-side only, for the parked API route in backend-later/.
# Leave WAITLIST_WEBHOOK_URL empty to run that route in demo mode.
WAITLIST_WEBHOOK_URL=
WAITLIST_WEBHOOK_SECRET=
